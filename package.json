{
	"name": "cloudflare-worker-sample-api",
	"version": "0.1.0",
	"private": true,
	"description": "Sample Cloudflare Worker API: R2 file storage, D1 share links, Google sign-in, cron cleanup.",
	"scripts": {
		"dev": "wrangler dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types",
		"migrate:local": "wrangler d1 migrations apply sample-api-db --local",
		"migrate:remote": "wrangler d1 migrations apply sample-api-db --remote",
		"deploy": "vitest run && wrangler deploy"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"@types/node": "^26.2.0",
		"typescript": "^5.5.2",
		"vitest": "~3.2.0",
		"wrangler": "^4.120.0"
	}
}
